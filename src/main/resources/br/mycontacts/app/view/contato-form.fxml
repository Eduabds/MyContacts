<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="br.mycontacts.app.ContatoFormController"
          hgap="12" vgap="12" minWidth="420">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <columnConstraints>
        <ColumnConstraints minWidth="75"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="260"/>
    </columnConstraints>
    <Label text="Nome:" GridPane.rowIndex="0"/>
    <TextField fx:id="campoNome" promptText="Nome completo"
               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    <Label text="Telefone:" GridPane.rowIndex="1"/>
    <TextField fx:id="campoTelefone" promptText="Telefone"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    <Label text="E-mail:" GridPane.rowIndex="2"/>
    <TextField fx:id="campoEmail" promptText="nome@exemplo.com"
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    <Label text="Tipo:" GridPane.rowIndex="3"/>
    <ComboBox fx:id="comboTipo" maxWidth="Infinity"
              GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    <Label text="Empresa:" GridPane.rowIndex="4"/>
    <TextField fx:id="campoEmpresa" promptText="Nome da empresa"
               GridPane.columnIndex="1" GridPane.rowIndex="4"/>
</GridPane>
